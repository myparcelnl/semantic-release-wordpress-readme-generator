{
  "name": "@myparcel-dev/semantic-release-wordpress-readme-generator",
  "version": "1.4.7",
  "description": "Generates a readme.txt for use with WordPress plugin releases in semantic-release",
  "repository": {
    "type": "git",
    "url": "https://github.com/myparcelnl/semantic-release-wordpress-readme-generator.git"
  },
  "license": "MIT",
  "author": "MyParcel <support@myparcel.nl>",
  "main": "./lib/semantic-release-wordpress-readme-generator.js",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepare": "is-ci || husky install"
  },
  "lint-staged": {
    "package.json": "pnpm dlx sort-package-json",
    "*.js": "eslint --fix"
  },
  "prettier": "@myparcel-dev/prettier-config",
  "release": {
    "extends": "@myparcel-dev/semantic-release-config/github-npm"
  },
  "dependencies": {
    "debug": "^4.0.0"
  },
  "devDependencies": {
    "@myparcel-dev/eslint-config-esnext": "^1.4.0",
    "@myparcel-dev/eslint-config-node": "^1.4.0",
    "@myparcel-dev/eslint-config-prettier": "^1.4.0",
    "@myparcel-dev/prettier-config": "^2.0.1",
    "@myparcel-dev/semantic-release-config": "^8.1.0",
    "eslint": "^8.38.0",
    "husky": "^8.0.1",
    "is-ci": "^3.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "semantic-release": "^25.0.9",
    "vite": "^6.4.5"
  },
  "peerDependencies": {
    "semantic-release": "^19 || ^20 || ^21 || ^22 || ^23 || ^24 || ^25"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.11",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
